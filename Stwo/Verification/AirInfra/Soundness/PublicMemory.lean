import Verification.AirInfra.Core.LookupTerm
import Verification.AirInfra.Core.Expressions.Felt252Expr

/-
  The Lookup Assumptions on the Public Memory

  These lookups are to be added to the list of lookups on top of the lookups
  generated by the components. They must all be memory use lookups and
  should agree with the public memory.
-/

-- Only memory use lookups
def AreMemoryUseLookups (lookups : Array (LookupTermVal rel_lengths)) :=
  (∀ t ∈ lookups, t.useOrYield = .use ∧ (t.rel = MEMORY_ADDR_TO_ID_REL_INDEX ∨ t.rel = MEMORY_ID_TO_VALUE_REL_INDEX))
-- The relation is encoded in the first position of the tuple
def RelInLookups (lookups : Array (LookupTermVal rel_lengths)) :=  ∀ t ∈ lookups, t.tuple 0 = t.rel

def PublicMem := Felt252 → Option Felt252

namespace PublicMem

structure Lookups where
  lookups : Array (LookupTermVal rel_lengths)
  rel_in_lookup: RelInLookups lookups
  h_mem : AreMemoryUseLookups lookups

-- The lookups agree with the public memory
def LookupsAgree (pub : PublicMem) (lookups : Lookups) :=
  ∀ addr252 value252,
    pub addr252 = some value252 →
      ∃ (addr id : Felt) (value : Felt252Words),
        addr.toFelt252 = addr252 ∧
        value.eval = value252 ∧
        {
          rel := MEMORY_ADDR_TO_ID_REL_INDEX,
          useOrYield := .use,
          tuple := p_tuple MEMORY_ADDR_TO_ID_REL_INDEX ![addr, id]
        } ∈ lookups.lookups ∧
        {
          rel := MEMORY_ID_TO_VALUE_REL_INDEX,
          useOrYield := .use,
          tuple := p_tuple MEMORY_ID_TO_VALUE_REL_INDEX ((Fin.append ![id] value) ∘ Fin.cast (by simp ; rfl)) } ∈ lookups.lookups

end PublicMem
